<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Solo.Ai.Client</PackageId>
    <Version>0.1.0-preview.3</Version>
    <Authors>SoloSpace</Authors>
    <Description>HTTP client and wire contracts for the Solo AI generation endpoint.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Solo.Toolbox" Version="1.2.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
